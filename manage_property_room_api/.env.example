# ═══════════════════════════════════════════════════════════════════════════════
# manage-property-room — API  ·  Variables de entorno
#
# En Dokploy: Service → Environment → Variables  (se aplican en runtime)
# En local:   Copia a .env y ajusta los valores
# ═══════════════════════════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8080
ENV=prod

# ── Base de datos ──────────────────────────────────────────────────────────────
DB_DRIVER=sqlite
DB_DSN=/data/app.db

# ── JWT ────────────────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 48
JWT_SECRET=REEMPLAZA_CON_SECRETO_SEGURO
JWT_TTL=24h

# ── CORS ───────────────────────────────────────────────────────────────────────
# Dominio exacto de la web app (sin barra final)
# Ejemplo: https://app.midominio.com
CORS_ORIGINS=https://app.midominio.com

# ── URL pública de la API ──────────────────────────────────────────────────────
# URL pública de ESTA API (sin barra final)
# Se usa para construir links de descarga de la APK/IPA
BASE_URL=https://api.midominio.com
