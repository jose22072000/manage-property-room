# ═══════════════════════════════════════════════════════════════════════════════
# manage-property-room — APP (Flutter Web)  ·  Variables de entorno
#
# ⚠️  API_BASE_URL se inyecta en COMPILE TIME, NO en runtime.
#
# En Dokploy: Service → Build → Build Arguments
#             Clave:  API_BASE_URL
#             Valor:  https://api.midominio.com
#             (NO lo pongas en Environment Variables — ahí no sirve)
#
# En local:   flutter build web --dart-define=API_BASE_URL=http://localhost:8080
# ═══════════════════════════════════════════════════════════════════════════════

# URL pública de la API (sin barra final)
API_BASE_URL=https://api.midominio.com
